# ==============================================================================
# 🌌 DEVLOVERS PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# Application Environment & Base URL
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 📦 PostgreSQL Database Configuration (Drizzle ORM)
# ------------------------------------------------------------------------------
# Connects to PostgreSQL. If left empty, Devlovers runs with hybrid in-memory
# fallback mocks so you can immediately explore all UI & mock data without setup.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devlovers

# ------------------------------------------------------------------------------
# 🔐 Supabase Authentication & Row Level Security (RLS)
# ------------------------------------------------------------------------------
# Required for live OAuth (GitHub, Google) and Magic Link passwordless auth.
# If omitted, platform falls back to simulated client auth with guest personas.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 🤖 Model Context Protocol (MCP) Server Security
# ------------------------------------------------------------------------------
# Optional Bearer Token / API Key to restrict external AI Agent calls to /api/mcp.
# If omitted or left empty, /api/mcp runs in open public JSON-RPC mode.
DEVLOVERS_MCP_API_KEY=devlovers-mcp-secret-key-optional

# ------------------------------------------------------------------------------
# ⚡ Edge Caching & On-Demand ISR Revalidation
# ------------------------------------------------------------------------------
# Secret token required to trigger on-demand cache purges at POST /api/revalidate.
REVALIDATION_SECRET=devlovers-revalidation-token-secret
